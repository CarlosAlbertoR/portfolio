    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^30.1.3",
